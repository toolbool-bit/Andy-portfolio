<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Andy Madeleine – Communication &amp; Digital Media</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#FBF6F1;--surface:#fff;--ink:#22142F;--mute:#6A5C78;--line:#E6DAD0;--violet:#6B3FFF;--peach:#FF9E73;--mint:#9FE8C6;--rose:#FF6B9A;
--d:'Bricolage Grotesque','Helvetica Neue',Arial,sans-serif;--b:'Figtree','Helvetica Neue',Arial,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#150C20;--surface:#211333;--ink:#F6EEFA;--mute:#B4A5C6;--line:#3A2852;--violet:#A58BFF}}
:root[data-theme="dark"]{--bg:#150C20;--surface:#211333;--ink:#F6EEFA;--mute:#B4A5C6;--line:#3A2852;--violet:#A58BFF}
html{scroll-behavior:smooth;scroll-padding-top:70px}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--b);-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--violet);outline-offset:3px;border-radius:6px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--d);margin:0;line-height:1;letter-spacing:-.03em}
nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font:800 20px var(--d);text-decoration:none;display:flex;align-items:center;gap:10px}
.logo i{width:14px;height:14px;border-radius:50%;background:var(--rose);box-shadow:0 0 0 4px color-mix(in srgb,var(--rose) 25%,transparent);animation:rec 1.6s infinite}
@keyframes rec{50%{opacity:.35}}
nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;font-weight:500;font-size:15px}
nav ul a{text-decoration:none;color:var(--mute)}nav ul a:hover{color:var(--ink)}
.tog{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:7px 14px;font:500 14px var(--b);cursor:pointer}
@media(max-width:700px){nav ul{display:none}}

/* hero */
.hero{position:relative;padding:72px 0 40px;overflow:hidden}
.hero .tag{display:inline-block;background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:6px 14px;font-size:14px;font-weight:500;color:var(--mute)}
.hero h1{font-size:clamp(64px,15vw,190px);font-weight:800;margin:22px 0 8px;letter-spacing:-.055em}
.hero h1 span{display:block}
.hero h1 .l2{background:linear-gradient(90deg,var(--violet),var(--rose) 55%,var(--peach));-webkit-background-clip:text;background-clip:text;color:transparent;padding-bottom:.08em}
.hero p{max-width:520px;font-size:20px;color:var(--mute);margin:18px 0 28px}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:14px 26px;border-radius:99px;font-weight:600;text-decoration:none;border:2px solid var(--ink);transition:transform .2s}
.btn:hover{transform:translateY(-3px)}
.btn.p{background:var(--ink);color:var(--bg)}
.playhead{position:absolute;top:0;bottom:0;left:0;width:2px;background:var(--rose);z-index:2;pointer-events:none;animation:sweep 2.4s cubic-bezier(.6,0,.2,1) 1 forwards}
.playhead::before{content:"";position:absolute;top:0;left:-7px;border:8px solid transparent;border-top-color:var(--rose)}
@keyframes sweep{from{left:0;opacity:1}90%{opacity:1}to{left:100%;opacity:0}}
.blob{position:absolute;right:-120px;top:40px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle at 30% 30%,var(--peach),var(--rose) 45%,var(--violet));opacity:.28;filter:blur(30px);z-index:-1}

/* ticker */
.ticker{border-block:1px solid var(--line);background:var(--ink);color:var(--bg);overflow:hidden;white-space:nowrap;padding:14px 0;font:600 22px var(--d)}
.ticker div{display:inline-flex;gap:40px;animation:mq 28s linear infinite;padding-left:40px}
.ticker b{color:var(--peach)}
@keyframes mq{to{transform:translateX(-50%)}}

section{padding:96px 0 0}
.sh{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:34px}
.sh h2{font-size:clamp(38px,6vw,68px);font-weight:800}
.filters{display:flex;gap:8px;flex-wrap:wrap}
.filters button{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:8px 18px;font:500 15px var(--b);cursor:pointer}
.filters button[aria-pressed="true"]{background:var(--violet);border-color:var(--violet);color:#fff}

/* work */
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:20px}
.card{grid-column:span 6;background:var(--surface);border:1px solid var(--line);border-radius:28px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s}
.card:hover{transform:translateY(-6px)}
.card.big{grid-column:span 12;flex-direction:row}
.card.big .art{min-height:340px;flex:1.3}.card.big .txt{flex:1;justify-content:center}
.art{min-height:230px;position:relative;display:grid;place-items:center;font:800 clamp(42px,7vw,84px) var(--d);color:rgba(255,255,255,.92);letter-spacing:-.05em}
.a1{background:linear-gradient(135deg,#6B3FFF,#FF6B9A)}
.a2{background:linear-gradient(135deg,#FF9E73,#FFD36B)}
.a3{background:linear-gradient(135deg,#17A589,#9FE8C6);color:#0F2F2A}
.a4{background:linear-gradient(135deg,#22142F,#6B3FFF)}
.art small{position:absolute;left:18px;bottom:14px;font:600 13px var(--b);letter-spacing:0;background:rgba(0,0,0,.28);padding:4px 12px;border-radius:99px;color:#fff}
.txt{padding:26px 28px 30px;display:flex;flex-direction:column;gap:10px}
.txt h3{font-size:28px}
.txt p{margin:0;color:var(--mute);font-size:16px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.chips span{font-size:13px;font-weight:600;border:1px solid var(--line);border-radius:99px;padding:3px 12px;color:var(--mute)}
.card[hidden]{display:none}
@media(max-width:800px){.card,.card.big{grid-column:span 12;flex-direction:column}.card.big .art{min-height:230px}}

/* about */
.about{display:grid;grid-template-columns:1fr 1.2fr;gap:56px;align-items:start}
.portrait{aspect-ratio:4/5;border-radius:200px 200px 28px 28px;background:linear-gradient(160deg,var(--mint),var(--peach) 55%,var(--rose));display:grid;place-items:center;font:800 130px var(--d);color:rgba(255,255,255,.9);letter-spacing:-.06em;position:relative}
.portrait::after{content:"Replace with your photo";position:absolute;bottom:16px;font:500 12px var(--b);letter-spacing:0;color:rgba(34,20,47,.6)}
.about p{color:var(--mute);margin:0 0 18px;max-width:60ch}
.about p:first-of-type{font:600 clamp(24px,3vw,32px)/1.25 var(--d);color:var(--ink);letter-spacing:-.02em}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px}
.stats div{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:18px}
.stats b{display:block;font:800 38px var(--d);letter-spacing:-.04em}
.stats span{font-size:14px;color:var(--mute)}
@media(max-width:800px){.about{grid-template-columns:1fr}.portrait{max-width:340px}}

/* skills timeline */
.tl{background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:28px}
.track{display:grid;grid-template-columns:150px 1fr;align-items:center;gap:16px;padding:10px 0;border-bottom:1px dashed var(--line)}
.track:last-child{border:0}
.track>span{font-weight:600;font-size:15px}
.lane{position:relative;height:38px;background:color-mix(in srgb,var(--line) 45%,transparent);border-radius:10px}
.clip{position:absolute;top:4px;bottom:4px;border-radius:8px;padding:0 12px;display:flex;align-items:center;font-size:13px;font-weight:600;color:#1a0f26;white-space:nowrap;overflow:hidden}
.c1{background:var(--peach)}.c2{background:var(--mint)}.c3{background:#C9B8FF}.c4{background:#FFB3CC}
@media(max-width:700px){.track{grid-template-columns:1fr;gap:6px}.clip{font-size:11px;padding:0 8px}}

/* contact */
.contact{margin-top:96px;background:var(--ink);color:var(--bg);border-radius:40px 40px 0 0;padding:80px 0 56px;text-align:center}
.contact h2{font-size:clamp(44px,9vw,120px);font-weight:800;margin-bottom:22px}
.contact p{color:color-mix(in srgb,var(--bg) 70%,transparent);max-width:460px;margin:0 auto 30px}
.contact .btn{background:var(--peach);color:#22142F;border-color:var(--peach);font-size:19px}
.links{display:flex;gap:26px;justify-content:center;margin-top:44px;flex-wrap:wrap;font-weight:500}
.links a{color:color-mix(in srgb,var(--bg) 75%,transparent)}
.links a:hover{color:var(--bg)}
footer{font-size:14px;margin-top:34px;color:color-mix(in srgb,var(--bg) 50%,transparent)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.playhead{display:none}}
</style>
</head>
<body>
<nav><div class="wrap">
  <a class="logo" href="#top"><i></i>Andy Madeleine</a>
  <ul><li><a href="#work">Work</a></li><li><a href="#about">About</a></li><li><a href="#skills">Skills</a></li><li><a href="#contact">Contact</a></li></ul>
  <button class="tog" id="tog" aria-label="Toggle light and dark theme">Theme</button>
</div></nav>

<header class="hero" id="top">
  <div class="playhead" aria-hidden="true"></div>
  <div class="blob" aria-hidden="true"></div>
  <div class="wrap">
    <span class="tag">Communication &amp; Digital Media student, age 20</span>
    <h1><span>Andy</span><span class="l2">Madeleine</span></h1>
    <p>I turn ideas into stories people actually watch, share and remember: video, social campaigns and brand voices.</p>
    <div class="btns"><a class="btn p" href="#work">See my work</a><a class="btn" href="#contact">Let’s collaborate</a></div>
  </div>
</header>

<div class="ticker" aria-hidden="true"><div>
  <span>Storytelling</span><b>●</b><span>Video editing</span><b>●</b><span>Social strategy</span><b>●</b><span>Brand voice</span><b>●</b><span>Content design</span><b>●</b><span>Podcasting</span><b>●</b>
  <span>Storytelling</span><b>●</b><span>Video editing</span><b>●</b><span>Social strategy</span><b>●</b><span>Brand voice</span><b>●</b><span>Content design</span><b>●</b><span>Podcasting</span><b>●</b>
</div></div>

<main>
<section id="work"><div class="wrap">
  <div class="sh"><h2>Selected work</h2>
    <div class="filters" role="group" aria-label="Filter projects">
      <button aria-pressed="true" data-f="all">All</button><button aria-pressed="false" data-f="video">Video</button><button aria-pressed="false" data-f="social">Social</button><button aria-pressed="false" data-f="brand">Brand</button><button aria-pressed="false" data-f="audio">Audio</button>
    </div>
  </div>
  <div class="grid">
    <article class="card big" data-c="social brand">
      <div class="art a1">+240%<small>Social campaign</small></div>
      <div class="txt"><h3>Campus Voices</h3><p>A student-led Instagram and TikTok series that grew a university club’s reach by 240% in one semester. I planned the content calendar, shot the clips and wrote every caption.</p><div class="chips"><span>Strategy</span><span>Short-form video</span><span>Copywriting</span></div></div>
    </article>
    <article class="card" data-c="video">
      <div class="art a2">Frame<small>Short film</small></div>
      <div class="txt"><h3>Frame by Frame</h3><p>A 4-minute documentary on the people behind Cairo’s street art. Directed, filmed and edited end to end.</p><div class="chips"><span>Directing</span><span>Premiere Pro</span></div></div>
    </article>
    <article class="card" data-c="audio">
      <div class="art a3">Tune In<small>Podcast</small></div>
      <div class="txt"><h3>Tune In</h3><p>A weekly podcast about how young creators build careers online. Ten episodes, recorded, mixed and published.</p><div class="chips"><span>Hosting</span><span>Audio editing</span></div></div>
    </article>
    <article class="card" data-c="brand">
      <div class="art a4">Alba<small>Brand identity</small></div>
      <div class="txt"><h3>Alba Coffee Rebrand</h3><p>A fresh name voice, tone guide and launch kit for a local coffee shop, built from customer interviews.</p><div class="chips"><span>Brand voice</span><span>Canva</span><span>Figma</span></div></div>
    </article>
    <article class="card" data-c="social video">
      <div class="art a1">30s<small>Motion graphics</small></div>
      <div class="txt"><h3>Explain It in 30</h3><p>A series of animated explainers that make complex news topics clear in half a minute.</p><div class="chips"><span>After Effects</span><span>Scriptwriting</span></div></div>
    </article>
  </div>
</div></section>

<section id="about"><div class="wrap">
  <div class="about">
    <div class="portrait" aria-label="Portrait placeholder">AM</div>
    <div>
      <p>I’m Andy, a 20-year-old communication and digital media student who believes every good idea deserves a clear, human story.</p>
      <p>I study how messages travel across screens, platforms and cultures, then put that to work: shooting, editing, writing and publishing. I like projects where strategy and creativity meet, and I learn fastest by making things in public.</p>
      <p>I’m looking for internships and collaborations in content, social media and digital storytelling.</p>
      <div class="stats">
        <div><b>12+</b><span>Projects shipped</span></div>
        <div><b>3</b><span>Platforms managed</span></div>
        <div><b>20</b><span>Years young, just starting</span></div>
      </div>
    </div>
  </div>
</div></section>

<section id="skills"><div class="wrap">
  <div class="sh"><h2>How I work</h2></div>
  <div class="tl" role="list">
    <div class="track" role="listitem"><span>Story</span><div class="lane"><div class="clip c1" style="left:0;width:34%">Research</div><div class="clip c3" style="left:36%;width:30%">Scriptwriting</div><div class="clip c2" style="left:68%;width:30%">Storyboarding</div></div></div>
    <div class="track" role="listitem"><span>Video</span><div class="lane"><div class="clip c2" style="left:8%;width:26%">Filming</div><div class="clip c1" style="left:36%;width:34%">Premiere Pro</div><div class="clip c4" style="left:72%;width:26%">After Effects</div></div></div>
    <div class="track" role="listitem"><span>Social</span><div class="lane"><div class="clip c4" style="left:0;width:30%">Content planning</div><div class="clip c3" style="left:32%;width:32%">Community</div><div class="clip c1" style="left:66%;width:32%">Analytics</div></div></div>
    <div class="track" role="listitem"><span>Design</span><div class="lane"><div class="clip c3" style="left:14%;width:28%">Canva</div><div class="clip c2" style="left:44%;width:26%">Figma</div><div class="clip c4" style="left:72%;width:26%">Photoshop</div></div></div>
  </div>
</div></section>
</main>

<footer-wrap>
<div class="contact" id="contact"><div class="wrap">
  <h2>Let’s make something.</h2>
  <p>Open to internships, freelance projects and creative collaborations. I reply within a day.</p>
  <a class="btn" href="mailto:andy.madeleine@example.com">Say hello</a>
  <div class="links"><a href="#">Instagram</a><a href="#">LinkedIn</a><a href="#">Behance</a><a href="#">YouTube</a></div>
  <footer>© 2026 Andy Madeleine</footer>
</div></div>
</footer-wrap>

<script>
(function(){
  var btns=document.querySelectorAll('.filters button'),cards=document.querySelectorAll('.card');
  btns.forEach(function(b){b.addEventListener('click',function(){
    btns.forEach(function(x){x.setAttribute('aria-pressed',x===b)});
    var f=b.dataset.f;
    cards.forEach(function(c){c.hidden=!(f==='all'||c.dataset.c.split(' ').indexOf(f)>-1)});
    var vis=[].filter.call(cards,function(c){return !c.hidden});
    cards.forEach(function(c){c.classList.remove('big')});
    if(vis.length&&(f==='all'))vis[0].classList.add('big');
  })});
  document.getElementById('tog').addEventListener('click',function(){
    var r=document.documentElement,dark=getComputedStyle(r).getPropertyValue('--bg').trim().toLowerCase()==='#150c20';
    r.setAttribute('data-theme',dark?'light':'dark');
  });
})();
</script>
</body>
</html>
